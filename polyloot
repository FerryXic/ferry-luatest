--==================================================
-- CREATURE UTILITIES
--==================================================

local function GetRootPart(obj)

	if not obj then
		return nil
	end

	if obj:IsA("BasePart") then
		return obj
	end

	if obj:IsA("Model") then

		if obj.PrimaryPart then
			return obj.PrimaryPart
		end

		return obj:FindFirstChild("HumanoidRootPart")
			or obj:FindFirstChild("Root")
			or obj:FindFirstChildWhichIsA("BasePart")
	end

	return nil
end

local function GetCreatures()

	local result = {}

	local AnimalLive = workspace:FindFirstChild("Animal_Live")

	if not AnimalLive then
		return result
	end

	-- AGGRESSORS
	if farmAggressors then

		local folder = AnimalLive:FindFirstChild("Aggressors")

		if folder then

			for _, creature in ipairs(folder:GetChildren()) do

				if creature.Parent and GetRootPart(creature) then
					table.insert(result, creature)
				end

			end
		end
	end

	-- PASSIVES
	if farmPassives then

		local folder = AnimalLive:FindFirstChild("Passives")

		if folder then

			for _, creature in ipairs(folder:GetChildren()) do

				if creature.Parent and GetRootPart(creature) then
					table.insert(result, creature)
				end

			end
		end
	end

	return result
end

local function IsCreatureAlive(creature)

	if not creature then
		return false
	end

	if not creature.Parent then
		return false
	end

	local humanoid = creature:FindFirstChildOfClass("Humanoid")

	if humanoid then
		return humanoid.Health > 0
	end

	return true
end

local function GetNearestCreature(maxDistance)

	local Character = Player.Character

	if not Character then
		return nil
	end

	local HRP = Character:FindFirstChild("HumanoidRootPart")

	if not HRP then
		return nil
	end

	local nearest = nil
	local nearestDistance = maxDistance or math.huge

	for _, creature in ipairs(GetCreatures()) do

		if creature.Parent then

			local root = GetRootPart(creature)

			if root then

				local distance =
					(HRP.Position - root.Position).Magnitude

				if distance < nearestDistance then

					nearestDistance = distance
					nearest = creature

				end
			end
		end
	end

	return nearest
end

--==================================================
-- TWEEN
--==================================================

local function CancelActiveTween()

	if activeTween then

		pcall(function()
			activeTween:Cancel()
		end)

		activeTween = nil
	end
end

--==================================================
-- AUTO FARM
--==================================================

local function StartFarm()

	if farming then
		return
	end

	farming = true

	task.spawn(function()

		while farming do

			local Character = Player.Character
			local HRP =
				Character
				and Character:FindFirstChild("HumanoidRootPart")

			if not Character or not HRP then

				task.wait(0.5)
				continue
			end

			local creature = GetNearestCreature()

			if not creature then

				task.wait(0.25)
				continue
			end

			while farming
				and creature.Parent
				and IsCreatureAlive(creature) do

				Character = Player.Character

				HRP =
					Character
					and Character:FindFirstChild("HumanoidRootPart")

				local root = GetRootPart(creature)

				if not HRP or not root then
					break
				end

				local distance =
					(HRP.Position - root.Position).Magnitude

				-- MOVE
				if distance > ATTACK_DISTANCE then

					local direction =
						HRP.Position - root.Position

					if direction.Magnitude < 0.1 then
						direction = Vector3.new(0, 0, 1)
					else
						direction = direction.Unit
					end

					local targetPosition =
						root.Position
						+ direction * (ATTACK_DISTANCE * 0.5)

					local moveDistance =
						(HRP.Position - targetPosition).Magnitude

					local duration =
						math.max(moveDistance / SPEED, 0.05)

					CancelActiveTween()

					activeTween = TweenService:Create(
						HRP,
						TweenInfo.new(
							duration,
							Enum.EasingStyle.Linear
						),
						{
							CFrame = CFrame.new(
								targetPosition,
								root.Position
							)
						}
					)

					activeTween:Play()

					task.wait(0.1)

				-- ATTACK
				else

					CancelActiveTween()

					pcall(function()

						HRP.CFrame = CFrame.lookAt(
							HRP.Position,
							Vector3.new(
								root.Position.X,
								HRP.Position.Y,
								root.Position.Z
							)
						)

					end)

					AttackCreature()

					task.wait(ATTACK_DELAY)
				end
			end

			CancelActiveTween()

			task.wait(0.2)
		end

		CancelActiveTween()
	end)
end

local function StopFarm()

	farming = false

	CancelActiveTween()
end

--==================================================
-- KILL AURA
--==================================================

local function StartKillAura()

	if killAura then
		return
	end

	killAura = true

	task.spawn(function()

		while killAura do

			local Character = Player.Character
			local HRP =
				Character
				and Character:FindFirstChild("HumanoidRootPart")

			if not HRP then

				task.wait(0.5)
				continue
			end

			local creature =
				GetNearestCreature(KILL_AURA_RADIUS)

			if creature then

				local root = GetRootPart(creature)

				if root then

					-- Hadap ke target
					pcall(function()

						HRP.CFrame = CFrame.lookAt(
							HRP.Position,
							Vector3.new(
								root.Position.X,
								HRP.Position.Y,
								root.Position.Z
							)
						)

					end)

					AttackCreature()
				end
			end

			task.wait(KILL_AURA_DELAY)
		end
	end)
end

local function StopKillAura()

	killAura = false
end

