local function CreateSwitch(parent, enabled)

	local Switch = Instance.new("Frame")

	Switch.Size = UDim2.new(0, 52, 0, 30)
	Switch.Position = UDim2.new(1, -65, 0.5, -15)

	Switch.BackgroundColor3 =
