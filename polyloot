Status.TextXAlignment =
	Enum.TextXAlignment.Center

Status.ZIndex = 20
Status.Parent = Content

--==================================================
-- MONSTER TYPE LOGIC
--==================================================

local MonsterTypes = {
	"Aggressors",
	"Passives",
	"Both"
}

local MonsterIndex = 1

local function ApplyMonsterType()

	if MonsterIndex == 1 then

		farmAggressors = true
		farmPassives = false

	elseif MonsterIndex == 2 then

		farmAggressors = false
		farmPassives = true

	else

		farmAggressors = true
		farmPassives = true
	end

	MonsterValue.Text =
		MonsterTypes[MonsterIndex]
end

ApplyMonsterType()

MonsterButton.MouseButton1Click:Connect(function()

	MonsterIndex += 1

	if MonsterIndex > #MonsterTypes then
		MonsterIndex = 1
	end

	ApplyMonsterType()

	-- kalau farm sedang berjalan,
	-- target berikutnya otomatis mengikuti type baru
end)

--==================================================
-- AUTO FARM BUTTON LOGIC
--==================================================

FarmButton.MouseButton1Click:Connect(function()

	farming = not farming

	SetSwitch(
		FarmSwitch,
		FarmCircle,
		farming
	)

	if farming then

		Status.Text =
			"AutoFarm : ON"

		Status.TextColor3 =
			GREEN

		StartFarm()

	else

		Status.Text =
			"AutoFarm : OFF"

		Status.TextColor3 =
			Color3.fromRGB(
				180,
				200,
				220
			)

		StopFarm()
	end
end)

--==================================================
-- KILLAURA BUTTON LOGIC
--==================================================

AuraButton.MouseButton1Click:Connect(function()

