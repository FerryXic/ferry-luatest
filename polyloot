local function CreateFeatureButton(
	name,
	y,
	height
)

	local Button = Instance.new("TextButton")

	Button.Name = name

	Button.Size =
		UDim2.new(
			1,
			0,
			0,
			height
		)

	Button.Position =
		UDim2.fromOffset(
			0,
			y
		)

	Button.BackgroundColor3 =
		BLACK

	Button.BorderSizePixel = 0

	Button.Text = ""

	Button.AutoButtonColor = false

	Button.ZIndex = 10
	Button.Parent = Content

	local corner = Instance.new("UICorner")

	corner.CornerRadius =
		UDim.new(0, 15)

	corner.Parent = Button

	-- inner dashed border
	local border = Instance.new("Frame")

	border.Size =
		UDim2.new(
			1,
			-4,
			1,
			-4
		)

	border.Position =
		UDim2.fromOffset(2, 2)

	border.BackgroundTransparency = 1
	border.BorderSizePixel = 0

	border.ZIndex = 15
	border.Parent = Button

	local borderCorner = Instance.new("UICorner")

	borderCorner.CornerRadius =
		UDim.new(0, 13)

	borderCorner.Parent = border

	-- dash horizontal/vertical
	local function Dash(
		size,
		position
	)

		local d = Instance.new("Frame")

		d.Size = size
		d.Position = position

		d.BackgroundColor3 =
			WHITE

		d.BorderSizePixel = 0

		d.ZIndex = 16
		d.Parent = border

		local c = Instance.new("UICorner")

		c.CornerRadius =
			UDim.new(1, 0)

		c.Parent = d
	end

	-- top / bottom
	for x = 8, 250, 25 do

		Dash(
			UDim2.fromOffset(14, 2),
			UDim2.fromOffset(x, 0)
		)

		Dash(
			UDim2.fromOffset(14, 2),
			UDim2.new(
				0,
				x,
				1,
				-2
			)
		)
	end

	-- left / right
	for yy = 8, height - 8, 20 do

		Dash(
			UDim2.fromOffset(2, 10),
			UDim2.fromOffset(0, yy)
		)

		Dash(
			UDim2.fromOffset(2, 10),
			UDim2.new(
				1,
				-2,
				0,
				yy
			)
		)
	end

	return Button
end

