--==================================================
-- DASHED BORDER SYSTEM
--==================================================

local function CreateDash(parent, size, position)
	local dash = Instance.new("Frame")

	dash.Size = size
	dash.Position = position

	dash.BackgroundColor3 = COLORS.White
	dash.BorderSizePixel = 0

	dash.ZIndex = 20
	dash.Parent = parent

	return dash
end

local function CreateDashedBorder(parent, width, height, dashLength, gap, thickness)

	-- TOP
	local x = 0

	while x < width do
		local length = math.min(dashLength, width - x)

		CreateDash(
			parent,
			UDim2.new(0, length, 0, thickness),
			UDim2.new(0, x, 0, 0)
		)

		x += dashLength + gap
	end

	-- BOTTOM
	x = 0

	while x < width do
		local length = math.min(dashLength, width - x)

		CreateDash(
			parent,
			UDim2.new(0, length, 0, thickness),
			UDim2.new(0, x, 1, -thickness)
		)

		x += dashLength + gap
	end

	-- LEFT
	local y = 0

	while y < height do
		local length = math.min(dashLength, height - y)

		CreateDash(
			parent,
			UDim2.new(0, thickness, 0, length),
			UDim2.new(0, 0, 0, y)
		)

		y += dashLength + gap
	end

	-- RIGHT
	y = 0

	while y < height do
		local length = math.min(dashLength, height - y)

		CreateDash(
			parent,
			UDim2.new(0, thickness, 0, length),
			UDim2.new(1, -thickness, 0, y)
		)

		y += dashLength + gap
	end
end

