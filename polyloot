        isOn = not isOn
        local goalPos = isOn and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
        local goalColor = isOn and Color3.fromRGB(40, 200, 80) or Color3.fromRGB(150, 150, 150)
        
        TweenService:Create(Circle, TweenInfo.new(0.2), {Position = goalPos}):Play()
        TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = goalColor}):Play()
        
        callback(isOn)
    end)
end

