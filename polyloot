local function SetSwitch(
	switch,
	circle,
	state
)

	switch.BackgroundColor3 =
		state and GREEN or GRAY

	local target =
		state
		and UDim2.new(
			1,
			-26,
			0,
			4
		)
		or UDim2.fromOffset(
			4,
			4
		)

	TweenService:Create(
		circle,
		TweenInfo.new(
			0.15,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			Position = target
		}
	):Play()
end

