-- SETTINGS & VARIABLES
--==================================================

local SPEED = 100
local ATTACK_DISTANCE = 10 
local ATTACK_DELAY = 0.25 
local AURA_RADIUS = 15 
local AURA_COOLDOWN = 0.25 

local farming = false
local auraAttacking = false
local farmAggressors = true
local farmPassives = false

--==================================================
-- GAME LOGIC
--==================================================

local function AttackCreature()
    pcall(function() WeaponAttack:FireServer(1) end)
end

local function GetRootPart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Root") or obj:FindFirstChildWhichIsA("BasePart")
    end
    return nil
end

local function GetCreatures()
    local result = {}
    local AnimalLive = workspace:FindFirstChild("Animal_Live")
    if not AnimalLive then return result end

    if farmAggressors then
        local folder = AnimalLive:FindFirstChild("Aggressors")
        if folder then
            for _, creature in ipairs(folder:GetChildren()) do
                if creature.Parent and GetRootPart(creature) then table.insert(result, creature) end
            end
        end
    end

    if farmPassives then
        local folder = AnimalLive:FindFirstChild("Passives")
        if folder then
            for _, creature in ipairs(folder:GetChildren()) do
                if creature.Parent and GetRootPart(creature) then table.insert(result, creature) end
            end
        end
    end
    return result
end

local function GetNearestCreature()
    local Character = Player.Character
    local HRP = Character and Character:FindFirstChild("HumanoidRootPart")
    if not HRP then return nil end

    local nearest, nearestDistance = nil, math.huge
    for _, creature in ipairs(GetCreatures()) do
        local root = GetRootPart(creature)
        if root then
            local distance = (HRP.Position - root.Position).Magnitude
            if distance < nearestDistance then
                nearestDistance = distance
                nearest = creature
            end
        end
    end
    return nearest
end

local function IsCreatureAlive(creature)
    if not creature or not creature.Parent then return false end
    local humanoid = creature:FindFirstChildOfClass("Humanoid")
    return humanoid and humanoid.Health > 0 or true
end

--==================================================
-- AURA ATTACK LOOP
--==================================================
local function StartAura()
    if auraAttacking then return end
    auraAttacking = true
    task.spawn(function()
        while auraAttacking do
            local Character = Player.Character
            local HRP = Character and Character:FindFirstChild("HumanoidRootPart")
            local attacked = false
            
            if Character and HRP then
                for _, creature in ipairs(GetCreatures()) do
                    if IsCreatureAlive(creature) then
                        local root = GetRootPart(creature)
                        if root and (HRP.Position - root.Position).Magnitude <= AURA_RADIUS then
                            if not attacked then
                                pcall(function() HRP.CFrame = CFrame.lookAt(HRP.Position, Vector3.new(root.Position.X, HRP.Position.Y, root.Position.Z)) end)
                            end
                            AttackCreature()
                            attacked = true
                        end
                    end
                end
            end
            task.wait(attacked and AURA_COOLDOWN or 0.03)
        end
    end)
end

local function StopAura() auraAttacking = false end

--==================================================
-- AUTO FARM LOOP
--==================================================
local activeTween = nil
local function CancelActiveTween()
    if activeTween then activeTween:Cancel(); activeTween = nil end
end

local function StartFarm()
    if farming then return end
    farming = true
    task.spawn(function()
        while farming do
            local Character = Player.Character
            local HRP = Character and Character:FindFirstChild("HumanoidRootPart")
            if not Character or not HRP then task.wait(1); continue end

            local creature = GetNearestCreature()
            if creature then
                while farming and creature.Parent and IsCreatureAlive(creature) do
                    Character = Player.Character
                    HRP = Character and Character:FindFirstChild("HumanoidRootPart")
                    local root = GetRootPart(creature)
                    if not HRP or not root then break end
                    
                    local direction = HRP.Position - root.Position
                    direction = direction.Magnitude < 0.1 and Vector3.new(0,0,1) or direction.Unit
                    
                    if (HRP.Position - root.Position).Magnitude > ATTACK_DISTANCE then
                        local targetPos = root.Position + direction * ATTACK_DISTANCE
                        local duration = math.max((HRP.Position - targetPos).Magnitude / SPEED, 0.05)
                        
                        CancelActiveTween()
                        activeTween = TweenService:Create(HRP, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos, root.Position)})
                        activeTween:Play()
                        task.wait(0.1)
                    else
                        CancelActiveTween()
                        if not auraAttacking then
                            pcall(function() HRP.CFrame = CFrame.lookAt(HRP.Position, Vector3.new(root.Position.X, HRP.Position.Y, root.Position.Z)) end)
                            AttackCreature()
                            task.wait(ATTACK_DELAY)
                        else
                            task.wait(0.1)
                        end
                    end
                end
                CancelActiveTween()
                task.wait(0.5) 
            else
                task.wait(0.3)
            end
        end
        CancelActiveTween()
    end)
end

local function StopFarm() farming = false end

