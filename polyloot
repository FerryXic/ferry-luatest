-- membuat dash kecil dengan sudut rounded
local function MakeDash(
	x,
	y,
	width,
	height,
	rotation
)

	local dash = Instance.new("Frame")

	dash.Size =
		UDim2.fromOffset(
			width,
			height
		)

	dash.Position =
		UDim2.fromOffset(
			x,
			y
		)

	dash.AnchorPoint =
		Vector2.new(0.5, 0.5)

	dash.Rotation = rotation

	dash.BackgroundColor3 = WHITE
	dash.BorderSizePixel = 0

	dash.ZIndex = 101

	dash.Parent = BorderLayer

	local corner = Instance.new("UICorner")

	corner.CornerRadius =
		UDim.new(1, 0)

	corner.Parent = dash

	return dash
end

-- dashed rounded rectangle
local function CreateRoundedDashedBorder(
	width,
	height,
	radius,
	dashLength,
	gap
)

	local perimeter =
		2 * (width - 2 * radius)
		+ 2 * (height - 2 * radius)
		+ 2 * math.pi * radius

	local distance = 0

	while distance < perimeter do

		local t =
			distance % perimeter

		local x
		local y
		local angle

		local topLength = width - 2 * radius
		local sideLength = height - 2 * radius
		local cornerLength = math.pi * radius / 2

		if t < topLength then

			x = radius + t
			y = 2
			angle = 0

		elseif t < topLength + cornerLength then

			local a =
				(t - topLength)
				/ radius

			x =
				width
				- radius
				+ math.sin(a) * radius

			y =
				radius
				- math.cos(a) * radius

			angle =
				math.deg(a)

		elseif t < topLength + cornerLength + sideLength then

			local d =
				t
				- topLength
				- cornerLength

			x = width - 2
			y = radius + d
			angle = 90

		elseif t < topLength + cornerLength * 2 + sideLength then

			local a =
				(t
					- topLength
					- cornerLength
					- sideLength)
				/ radius

			x =
				width
				- radius
				+ math.cos(a)
				* radius

			y =
				height
				- radius
				+ math.sin(a)
				* radius

			angle =
				math.deg(a) + 90

		elseif t < topLength
			+ cornerLength * 2
			+ sideLength
			+ topLength then

			local d =
				t
				- topLength
				- cornerLength * 2
				- sideLength

			x =
				width
				- radius
				- d

			y = height - 2
			angle = 0

		elseif t < topLength
			+ cornerLength * 3
			+ sideLength
			+ topLength then

			local a =
				(t
					- topLength
					- cornerLength * 2
					- sideLength
					- topLength)
				/ radius

			x =
				radius
				- math.sin(a) * radius

			y =
				height
				- radius
				+ math.cos(a) * radius

			angle =
				math.deg(a)

		elseif t < topLength * 2
			+ cornerLength * 3
			+ sideLength then

			local d =
				t
				- topLength
				- cornerLength * 3
				- sideLength
				- topLength

			x = 2
			y =
				height
				- radius
				- d

			angle = 90

		else

			local a =
				(t
					- topLength * 2
					- cornerLength * 3
					- sideLength)
				/ radius

			x =
				radius
				- math.cos(a) * radius

			y =
				radius
				- math.sin(a) * radius

			angle =
				math.deg(a) + 90
		end

		MakeDash(
			x,
			y,
			dashLength,
			3,
			angle
		)

		distance +=
			dashLength + gap
	end
end

